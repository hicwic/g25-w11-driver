{
  "version": 5,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "vs2022-x64",
      "displayName": "Visual Studio 2022 x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs2022-x64",
      "cacheVariables": { "BUILD_TESTING": "ON", "G25_BUILD_TOOL": "ON", "G25_BUILD_DIRECTINPUT": "ON", "G25_BUILD_TRAY": "ON" }
    },
    {
      "name": "vs2022-x86",
      "displayName": "Visual Studio 2022 Win32",
      "generator": "Visual Studio 17 2022",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/build/vs2022-x86",
      "cacheVariables": { "BUILD_TESTING": "ON", "G25_BUILD_TOOL": "ON", "G25_BUILD_DIRECTINPUT": "ON", "G25_BUILD_TRAY": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "vs2022-x64", "configuration": "Debug" },
    { "name": "release", "configurePreset": "vs2022-x64", "configuration": "Release" },
    { "name": "release-x86", "configurePreset": "vs2022-x86", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "vs2022-x64", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "vs2022-x64", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "release-x86", "configurePreset": "vs2022-x86", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
